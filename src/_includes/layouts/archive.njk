---
layout: layouts/base.njk
---
{%- set t = i18n[lang] -%}
			<div class="archive-header">
				<i class="fas fa-{{ "calendar" if archive.kind == "month" else ("folder-open" if archive.kind == "category" else "tag") }}" aria-hidden="true"></i>
				<h1>{{ t.archiveLabel[archive.kind] }}: <span>{{ archive.name }}</span></h1>
			</div>
{% set loopPosts = archive.posts %}{% include "partials/post-loop.njk" %}
{% set pageHrefs = archive.hrefs %}{% set pageIndex = archive.pageNumber %}{% include "partials/pagination.njk" %}
